# ── Anthropic (חובה) ─────────────────────────────────────────────
# מפתח ה-API של Claude. השג ב-https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# דגם ה-AI. ברירת מחדל: claude-sonnet-5 (מהיר וחסכוני).
# אפשר להחליף לדגם חזק יותר לפי הצורך.
ANTHROPIC_MODEL=claude-sonnet-5

# ── Resend – שליחת מיילים (חובה לשליחה בפועל) ─────────────────────
# מפתח API מ-https://resend.com  (חינמי עד 3,000 מיילים/חודש)
RESEND_API_KEY=re_...

# כתובת השולח. חייבת להיות מאומתת ב-Resend (דומיין מאומת).
# לדוגמה: "השם שלי <me@mydomain.com>"
FROM_EMAIL=Your Name <you@yourdomain.com>
